# ── Where the page gets its content ────────────────────────────────────────
#
# THIS IS THE SWITCH between the two modes:
#
#   unset (default)  Every string, image and film comes from the copy baked
#                    into src/lib/cms.ts — exactly what this site has always
#                    shipped. No network call, nothing to go down.
#
#   set              The page reads GET {VITE_CMS_URL}/api/content from the
#                    Laravel panel, so the client can edit the site themselves.
#                    The contact form and newsletter start posting there too;
#                    without it the contact form keeps its mailto: fallback.
#
# Fetched on the server during SSR, so the panel's copy is in the HTML that
# crawlers see. If the API is slow or unreachable the page falls back to the
# baked-in copy rather than rendering empty — so flipping this on cannot take
# the site down, and clearing it puts things back exactly as they were.
#
# No trailing slash needed, it gets stripped either way.
#
# VITE_CMS_URL=https://api.elitewing.sa


# ── Origin for the full portfolio films (public/media/<slug>.mp4) ──────────
#
# Only used when VITE_CMS_URL is unset; the panel supplies its own absolute
# URLs, served from the same host as the API.
#
# Leave unset to serve them from the app itself — correct for local dev and for
# the VPS later. Set it to move only the films off the app origin, which is what
# Cloudflare Pages needs since its free plan does not allow serving video.
# Posters and hover loops are small and always stay local.
#
# VITE_MEDIA_URL=https://cdn.example.com/media
